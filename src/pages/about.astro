---
import CtaBanner from "@/components/sections/CtaBanner.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Principles from "@/components/sections/Principles.astro";
import Stats from "@/components/sections/Stats.astro";
import StorySection from "@/components/sections/StorySection.astro";
import TeamSection from "@/components/sections/TeamSection.astro";
import { getAboutPage } from "@/config/pages/about";
import { resolveLocale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const aboutPage = getAboutPage(resolveLocale(Astro.currentLocale));
---

<BaseLayout {...aboutPage.meta}>
  <PageHero {...aboutPage.hero} />
  <Principles items={aboutPage.principles} />
  <StorySection story={aboutPage.story} />
  <Stats content={aboutPage.stats} />
  <TeamSection team={aboutPage.team} />
  <CtaBanner content={aboutPage.cta} />
</BaseLayout>
