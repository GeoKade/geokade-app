---
import Button from "@/components/ui/Button.astro";
import Logo from "@/components/ui/Logo.astro";
import { getSiteConfig } from "@/config/site";
import { resolveLocale } from "@/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileMenu from "./MobileMenu.astro";
import NavLinks from "./NavLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";

const locale = resolveLocale(Astro.currentLocale);
const siteConfig = getSiteConfig(locale);
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur-md">
  <!-- Desktop (1024px and up) -->
  <div class="mx-auto hidden h-[51.5px] max-w-[108rem] items-stretch justify-between lg:flex">
    <nav aria-label="Main" class="flex items-stretch">
      <div class="flex items-center border-r border-line px-4">
        <Logo locale={locale} showName size="sm" />
      </div>
      <NavLinks links={siteConfig.nav.main} />
    </nav>
    <div class="flex items-center gap-2 border-l border-line pr-1.5 pl-4">
      <LanguageSwitcher locale={locale} label={siteConfig.ui.language} />
      <ThemeToggle lightLabel={siteConfig.ui.themeLight} darkLabel={siteConfig.ui.themeDark} />
      <Button href={siteConfig.cta.href}>{siteConfig.cta.label}</Button>
    </div>
  </div>

  <!-- Mobile and tablet -->
  <div class="flex h-11 items-center justify-between gap-2 px-4 sm:px-6 lg:hidden">
    <Logo locale={locale} showName size="xs" />
    <div class="flex items-center gap-1.5">
      <LanguageSwitcher locale={locale} label={siteConfig.ui.language} />
      <ThemeToggle lightLabel={siteConfig.ui.themeLight} darkLabel={siteConfig.ui.themeDark} />
      <MobileMenu
        links={siteConfig.nav.mobile}
        openLabel={siteConfig.ui.openMenu}
        closeLabel={siteConfig.ui.closeMenu}
      />
    </div>
  </div>
</header>
