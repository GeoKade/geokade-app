---
import { getSiteConfig } from "@/config/site";
import { defaultLocale, localePath, type Locale } from "@/i18n";
import { cn } from "@/lib/utils";

interface Props {
  showName?: boolean;
  /** Kept for call-site compatibility; layers mark is the only mark. */
  alt?: boolean;
  size?: "xs" | "sm" | "md";
  class?: string;
  locale?: Locale;
}

/**
 * GeoKade mark: three stacked map layers (same silhouette as geokade.nl).
 * Orange stack matches brand / CTA accent for a single visual system.
 */
const { showName = false, size = "md", class: className, locale = defaultLocale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const homeHref = localePath(locale, "");

const iconSize = { xs: "size-5", sm: "size-6", md: "size-7" }[size];
const textSize = size === "xs" ? "text-sm leading-5" : "text-base leading-6";
---

<a
  href={homeHref}
  class={cn("inline-flex items-center gap-2 rounded-button", className)}
  aria-label={`${siteConfig.name} – home`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
    class={cn(iconSize, "shrink-0")}
    aria-hidden="true"
  >
    <path d="M16 3.5 27 10.2 16 16.9 5 10.2 16 3.5Z" fill="#FFB088" />
    <path d="M16 9.5 27 16.2 16 22.9 5 16.2 16 9.5Z" fill="#FF4820" />
    <path d="M16 15.5 27 22.2 16 28.9 5 22.2 16 15.5Z" fill="#C2410C" />
  </svg>
  {
    showName && (
      <span class={cn("font-semibold tracking-tight text-ink", textSize)}>{siteConfig.name}</span>
    )
  }
</a>
